APP_ENV=development
# ECS 公网演示入口。仅 frontend/nginx 映射此端口。
APP_PORT=80
APP_SECRET_KEY=change-this-before-public-deployment
POSTGRES_DB=ecommerce_ops
POSTGRES_USER=ecommerce_ops
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+psycopg://ecommerce_ops:change-this-database-password@postgres:5432/ecommerce_ops
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
TEXT_MODEL=Qwen/Qwen3.6-27B
ANALYSIS_MODEL=deepseek-ai/DeepSeek-V3.2
IMAGE_MODEL=Kwai-Kolors/Kolors
VIDEO_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B
VIDEO_T2V_MODEL=Wan-AI/Wan2.2-T2V-A14B
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
AI_MODE=mock
MEDIA_MODE=mock
STORAGE_DIR=/app/storage
DEMO_OPERATOR_PASSWORD=
DEMO_MANAGER_PASSWORD=
